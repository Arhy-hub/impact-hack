# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# SolvaPay sandbox (optional). Without these, a local stand-in supplier is used.
SOLVAPAY_SECRET_KEY=
SOLVAPAY_PRODUCT_REF=

# Google Calendar "secret address in iCal format" (optional). Treat it like a password.
HEATWISE_ICAL_URL=
